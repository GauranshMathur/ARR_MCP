# Copy to .env and fill in. Never commit .env.
#
# Pick ONE of the two sections below. They are alternatives, not layers: passing
# --config (or setting ARR_MCP_CONFIG) makes the server read the file and ignore
# section 2 entirely.
#
# Not sure which? One instance of each service -> section 2. Two Sonarrs, or a
# Bazarr per *arr pair -> section 1.

# ---------------------------------------------------------------------------
# 1. With a config file (multiple instances per service)
#
# config.yaml holds the URLs and instance names; only the secrets live here, and
# are referenced from the file as ${VAR}. An unset or empty value is a startup
# error, so delete the lines for instances you have not configured.
# ---------------------------------------------------------------------------
SONARR_MAIN_API_KEY=
SONARR_ANIME_API_KEY=
RADARR_MAIN_API_KEY=
RADARR_4K_API_KEY=
PROWLARR_API_KEY=
BAZARR_TV_API_KEY=
BAZARR_MOVIES_API_KEY=
# Download clients authenticate with a username and password, not a key.
QBITTORRENT_PASSWORD=
NZBGET_PASSWORD=

# ---------------------------------------------------------------------------
# 2. Without a config file (one instance per service)
#
# Set <SERVICE>_URL and <SERVICE>_API_KEY (or, for qbittorrent and nzbget,
# <SERVICE>_USERNAME and <SERVICE>_PASSWORD) and run without --config. A service
# is configured only when ALL of its variables are set; leave them blank or
# commented out and that service is simply not exposed. At least one service
# must be configured or startup fails.
#
# Find each *arr key in the app's own UI, under Settings -> General -> Security.
# qBittorrent: Tools -> Options -> Web UI. NZBGet: Settings -> Security
# (ControlUsername / ControlPassword).
#
# The URL must be reachable FROM THE CONTAINER. localhost inside a container
# means that container, not your machine: use the host's LAN IP, the other
# container's service name if they share a Docker network, or
# host.docker.internal on Docker Desktop.
# ---------------------------------------------------------------------------
# SONARR_URL=http://192.168.10.12:8989
# SONARR_API_KEY=
# RADARR_URL=http://192.168.10.14:7878
# RADARR_API_KEY=
# PROWLARR_URL=http://192.168.10.18:9696
# PROWLARR_API_KEY=
# BAZARR_URL=http://192.168.10.16:6767
# BAZARR_API_KEY=
# QBITTORRENT_URL=http://192.168.10.20:8080
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=
# NZBGET_URL=http://192.168.10.21:6789
# NZBGET_USERNAME=nzbget
# NZBGET_PASSWORD=
