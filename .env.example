# Copy to .env and fill in. Never commit .env.
#
# Two ways to configure ARR-MCP:
#
# 1. Config file (multi-instance). Reference these from config.yaml as ${VAR}.
SONARR_MAIN_API_KEY=
SONARR_ANIME_API_KEY=
RADARR_MAIN_API_KEY=
RADARR_4K_API_KEY=
PROWLARR_API_KEY=
BAZARR_TV_API_KEY=
BAZARR_MOVIES_API_KEY=

# 2. No config file (single instance per service). Set <SERVICE>_URL and
#    <SERVICE>_API_KEY and run without --config.
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=
